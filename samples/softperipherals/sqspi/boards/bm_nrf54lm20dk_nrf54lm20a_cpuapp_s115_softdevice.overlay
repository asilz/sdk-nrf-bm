/delete-node/ &app_ram;

&cpuapp_sram {
	flpr_firmware_ram: sram@4380 {
		label = "flpr_firmware_ram";
		reg = <0x4380 0x3740>;
	};

	flpr_execution_ram: sram@7ac0 {
		label = "flpr_execution_ram";
		reg = <0x7ac0 0x400>;
	};

	flpr_vri_ram: sram@7ec0 {
		label = "flpr_vri_ram";
		reg = <0x7ec0 0x200>;
	};

	app_ram: sram@80c0 {
		label = "app_ram";
		reg = <0x80c0 (DT_SIZE_K(261) + 0x140)>;
	};
};
